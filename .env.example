# Netlify → Site settings → Environment variables. Nunca fazer commit dos valores reais.

# build (leitura). Chave anon é pública; RLS só expõe status='published'.
SUPABASE_URL=https://rinfpezlwqmblwpzfdlm.supabase.co
SUPABASE_ANON_KEY=sb_publishable_AkwUkZnNumWFAXKWSXod6g_2h0zIWE-

# SÓ para netlify/functions (server-side). Marcar como "Functions" scope no painel.
SUPABASE_SERVICE_ROLE_KEY=

# Netlify → Build & deploy → Build hooks → criar → colar aqui E no Vault (002_netlify_webhook.sql)
NETLIFY_BUILD_HOOK=https://api.netlify.com/build_hooks/XXXXXXXX
NETLIFY_BUILD_HOOK_FALLBACK=0

# escritor automático (netlify/functions/autopilot-writer.mjs). Só scope Functions.
ANTHROPIC_API_KEY=
AUTOPILOT_STATUS=draft
AUTOPILOT_MODEL=claude-sonnet-5
# fila vazia → o escritor propõe um tema novo (1 = sim, 0 = só temas da fila)
AUTOPILOT_AUTOTOPIC=1
# não escreve mais enquanto houver N rascunhos por rever no admin
AUTOPILOT_MAX_DRAFTS=3
